{
  "name": "mynx-next",
  "private": true,
  "version": "3.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "repository": "https://github.com/hanhan124/mynx",
  "scripts": {
    "dev": "vite --port 1421 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig tsconfig.json",
    "check:watch": "svelte-check --tsconfig tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "tauri": "tauri",
    "typecheck": "svelte-check --tsconfig tsconfig.json",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:r:engine": "npm --prefix .. run test:r:engine",
    "charts:check": "npm --prefix .. run charts:check",
    "charts:verify": "npm --prefix .. run charts:verify",
    "resources:check": "npm --prefix .. run resources:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/svelte": "^5.0.9",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "prettier": "^3.10.1",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tabler/icons-svelte": "^3.52.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/svelte-table": "^9.3.2",
    "@tanstack/svelte-virtual": "^3.13.52",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-updater": "2.10.1",
    "bits-ui": "^1.8.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.6"
  }
}
