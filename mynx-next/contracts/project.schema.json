  "settingsDoc": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SettingsDoc",
    "description": "Full settings document persisted in SQLite (`settings` key-value table).\nEvery field maps to a legacy config key.",
    "type": "object",
    "properties": {
      "theme": {
        "description": "legacy key `theme`",
        "$ref": "#/$defs/ThemeId",
        "default": "pearl"
      },
      "alwaysOnTop": {
        "description": "legacy key `alwaysOnTop`",
        "type": "boolean",
        "default": false
      },
      "chartColor": {
        "description": "legacy key `chartColor` (\"#RRGGBB[AA]\")",
        "type": "string",
        "default": "#3C9FDF"
      },
      "language": {
        "description": "legacy localStorage `mynx-language`",
        "type": "string",
        "default": "zh"
      },
      "searchEngine": {
        "description": "legacy localStorage `mynx-search-engine`",
        "type": "string",
        "default": ""
      },
      "homeHeaderHeight": {
        "description": "legacy localStorage `mynx-home-header-height`",
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "default": 0
      },
      "imageConverterOptions": {
        "description": "legacy key `imageConverterOptions` (opaque tool options blob)",
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ],
        "default": null
      },
      "chartStudioPresets": {
        "description": "legacy key `chartStudioPresets`",
        "type": "array",
        "items": {
          "$ref": "#/$defs/ChartPreset"
        },
        "default": []
      }
    },
    "$defs": {
      "ThemeId": {
        "description": "Theme identifiers. `graphite` is the dark surface, `pearl` the light one;\nthe legacy `dark`/`light` values normalize onto these.",
        "type": "string",
        "enum": [
          "system",
          "graphite",
          "pearl"
        ]
      },
      "ChartPreset": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "config": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id",
          "name",
          "config",
          "updatedAt"
        ]
      }
    }
  }
}