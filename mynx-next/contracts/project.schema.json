{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "title": "Mynx project documents",
  "rnaseqConfig": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RnaSeqConfig",
    "description": "Full analysis configuration — the params.json contract.",
    "type": "object",
    "properties": {
      "data_file": {
        "type": "string",
        "default": ""
      },
      "output_dir": {
        "type": "string",
        "default": ""
      },
      "run_name": {
        "type": "string",
        "default": "auto"
      },
      "sample_labels": {
        "description": "Insertion order matters (sample display order); preserved via\nserde_json's `preserve_order` feature.",
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ],
        "default": {}
      },
      "batch": {
        "description": "batch covariate: `{\"b1\": [\"s1\",\"s2\"], ...}` (order preserved)",
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ],
        "default": {}
      },
      "overall_genes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "RPE65",
          "MITF",
          "BEST1",
          "NANOG",
          "SOX2",
          "POU5F1",
          "PAX6",
          "PMEL",
          "RAX",
          "TYR",
          "OTX2",
          "TYRP1",
          "MERTK",
          "LHX2",
          "VSX2",
          "DCT",
          "RLBP1"
        ]
      },
      "gene_clusters": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ],
        "default": {
          "Transcription": [
            "MITF",
            "OTX2",
            "PAX6",
            "RAX"
          ],
          "Melanogenesis": [
            "TYR",
            "TYRP1",
            "PMEL",
            "MLANA"
          ],
          "Visual_Cycle": [
            "RPE65",
            "RDH5",
            "RLBP1"
          ],
          "Phagocytosis": [
            "MERTK",
            "ITGAV"
          ],
          "Ion_Transport": [
            "BEST1",
            "ATP1A1"
          ],
          "Tight_Junctions": [
            "TJP1",
            "AQP1"
          ],
          "Cytoskeleton": [
            "EZR"
          ],
          "Secreted": [
            "SERPINF1",
            "VEGFA"
          ]
        }
      },
      "input": {
        "$ref": "#/$defs/InputOptions",
        "default": {
          "count_file": "",
          "gene_col": 1,
          "drop_empty_gene": true,
          "duplicate_genes": "sum",
          "rounding": "round"
        }
      },
      "groups": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ],
        "default": {}
      },
      "de": {
        "$ref": "#/$defs/DeOptions",
        "default": {
          "method": "deseq2",
          "padj": 0.05,
          "log2fc": 1.0,
          "bcv": 0.4,
          "shrink": "none",
          "use_batch": true,
          "filter": {
            "method": "filterByExpr",
            "min_count": 10.0,
            "min_total_count": 15.0,
            "min_samples": 2
          }
        }
      },
      "comparisons": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Comparison"
        },
        "default": []
      },
      "heatmap": {
        "$ref": "#/$defs/HeatmapStyle",
        "default": {
          "transform": "vst",
          "scale": "row",
          "palette": "RdBu",
          "reverse_palette": true,
          "zlim": 2.0,
          "group_palette": "Set2",
          "gene_group_palette": "Dark2",
          "cluster_rows": true,
          "cluster_columns": false,
          "row_distance": "pearson",
          "column_distance": "euclidean",
          "cluster_method": "ward.D2",
          "column_names_rot": 0.0,
          "column_names_side": "top",
          "group_bar_height": 1.0,
          "cluster_bar_width": 5.0,
          "cluster_bar_side": "left",
          "row_title_rot": 0.0,
          "show_row_title": true,
          "row_names_italic": true,
          "show_column_names": true,
          "show_annotation_name": false,
          "group_legend_title": "",
          "show_title": false,
          "show_batch": true,
          "font_size": 9.0,
          "marker_font_size": 8.0,
          "max_cluster_rows": 5000,
          "raster_quality": 1,
          "formats": [
            "png"
          ],
          "dpi": 600
        }
      },
      "overall_heatmap": {
        "$ref": "#/$defs/OverallHeatmap",
        "default": {
          "enabled": true,
          "name": "overall",
          "gene_source": "variable",
          "top_n": "all",
          "expressed_only": true,
          "max_genes": 2000,
          "marker_genes": [
            "RPE65",
            "MITF",
            "BEST1",
            "NANOG",
            "SOX2",
            "POU5F1",
            "PAX6",
            "PMEL",
            "RAX",
            "TYR",
            "OTX2",
            "TYRP1",
            "MERTK",
            "LHX2",
            "VSX2",
            "DCT",
            "RLBP1"
          ],
          "marker_add_missing": true,
          "n_clusters": 3,
          "sample_correlation": true,
          "correlation_palette": "YlOrRd",
          "correlation_show_annotation_name": false
        }
      },
      "selected_heatmaps": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SelectedHeatmapJob"
        },
        "default": [
          {
            "name": "gene_clusters",
            "title": "RPE gene clusters",
            "options": {
              "cluster_rows": false,
              "cluster_columns": false,
              "show_row_dend": true,
              "show_column_dend": true,
              "border": false,
              "show_row_title": false,
              "width": 4.5
            }
          }
        ]
      },
      "plots": {
        "$ref": "#/$defs/PlotsConfig",
        "default": {
          "formats": [
            "png"
          ],
          "dpi": 300,
          "font_family": "Arial",
          "base_size": 7.0,
          "group_palette": "npg",
          "plot_pad_mm": 2.0,
          "label_halo": true,
          "legend_gap_mm": 0.8,
          "pca": [
            {
              "name": "PCA_selected",
              "ntop": 500,
              "pcs": [
                1,
                2
              ],
              "label_samples": true,
              "ellipse": false,
              "legend_pos": "right",
              "square_panel": true,
              "width_mm": 76.0,
              "height_mm": 62.0
            }
          ],
          "volcano": {
            "enabled": true,
            "label_top": 10,
            "point_size": 0.5,
            "width_mm": 78.0,
            "height_mm": 70.0,
            "legend_pos": "right",
            "show_subtitle": false
          },
          "additional": {
            "enabled": true,
            "ma": true,
            "sample_distance": true,
            "mds": true,
            "library_size": true,
            "expression_distribution": true,
            "deg_summary": true,
            "deg_dotplot": true,
            "gene_expression": true,
            "upset": true,
            "deg_matrix": true,
            "inferential_annotations": false,
            "top_n": 15,
            "label_top": 10,
            "genes": [
              "RPE65",
              "MITF",
              "BEST1",
              "NANOG",
              "SOX2",
              "POU5F1",
              "PAX6",
              "PMEL",
              "RAX",
              "TYR",
              "OTX2",
              "TYRP1",
              "MERTK",
              "LHX2",
              "VSX2",
              "DCT",
              "RLBP1"
            ],
            "width_mm": 89.0,
            "height_mm": 70.0
          }
        }
      },
      "steps": {
        "description": "Runtime-injected by the runner; not part of user-editable config.",
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "$defs": {
      "InputOptions": {
        "type": "object",
        "properties": {
          "count_file": {
            "type": "string",
            "default": ""
          },
          "gene_col": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 1
          },
          "drop_empty_gene": {
            "type": "boolean",
            "default": true
          },
          "duplicate_genes": {
            "$ref": "#/$defs/DuplicateGenes",
            "default": "sum"
          },
          "rounding": {
            "$ref": "#/$defs/CountRounding",
            "default": "round"
          }
        }
      },
      "DuplicateGenes": {
        "type": "string",
        "enum": [
          "sum",
          "max_mean",
          "make_unique"
        ]
      },
      "CountRounding": {
        "type": "string",
        "enum": [
          "round",
          "floor",
          "ceiling"
        ]
      },
      "DeOptions": {
        "type": "object",
        "properties": {
          "method": {
            "$ref": "#/$defs/DeMethod",
            "default": "deseq2"
          },
          "padj": {
            "type": "number",
            "format": "double",
            "default": 0.05
          },
          "log2fc": {
            "type": "number",
            "format": "double",
            "default": 1.0
          },
          "bcv": {
            "type": "number",
            "format": "double",
            "default": 0.4
          },
          "shrink": {
            "$ref": "#/$defs/ShrinkMethod",
            "default": "none"
          },
          "use_batch": {
            "type": "boolean",
            "default": true
          },
          "filter": {
            "$ref": "#/$defs/DeFilter",
            "default": {
              "method": "filterByExpr",
              "min_count": 10.0,
              "min_total_count": 15.0,
              "min_samples": 2
            }
          }
        }
      },
      "DeMethod": {
        "type": "string",
        "enum": [
          "deseq2",
          "edger"
        ]
      },
      "ShrinkMethod": {
        "type": "string",
        "enum": [
          "none",
          "apeglm",
          "ashr"
        ]
      },
      "DeFilter": {
        "type": "object",
        "properties": {
          "method": {
            "$ref": "#/$defs/FilterMethod",
            "default": "filterByExpr"
          },
          "min_count": {
            "type": "number",
            "format": "double",
            "default": 10.0
          },
          "min_total_count": {
            "type": "number",
            "format": "double",
            "default": 15.0
          },
          "min_samples": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 2
          }
        }
      },
      "FilterMethod": {
        "type": "string",
        "enum": [
          "filterByExpr",
          "min_count",
          "none"
        ]
      },
      "Comparison": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "default": ""
          },
          "case": {
            "type": "string",
            "default": ""
          },
          "control": {
            "type": "string",
            "default": ""
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/$defs/ComparisonMode"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ComparisonMode": {
        "type": "string",
        "enum": [
          "auto",
          "replicate",
          "noreplicate"
        ]
      },
      "HeatmapStyle": {
        "type": "object",
        "properties": {
          "transform": {
            "$ref": "#/$defs/HeatmapTransform",
            "default": "vst"
          },
          "scale": {
            "$ref": "#/$defs/HeatmapScale",
            "default": "row"
          },
          "palette": {
            "type": "string",
            "default": "RdBu"
          },
          "reverse_palette": {
            "type": "boolean",
            "default": true
          },
          "zlim": {
            "type": "number",
            "format": "double",
            "default": 2.0
          },
          "group_palette": {
            "type": "string",
            "default": "Set2"
          },
          "gene_group_palette": {
            "type": "string",
            "default": "Dark2"
          },
          "cluster_rows": {
            "type": "boolean",
            "default": true
          },
          "cluster_columns": {
            "type": "boolean",
            "default": false
          },
          "row_distance": {
            "type": "string",
            "default": "pearson"
          },
          "column_distance": {
            "type": "string",
            "default": "euclidean"
          },
          "cluster_method": {
            "type": "string",
            "default": "ward.D2"
          },
          "column_names_rot": {
            "type": "number",
            "format": "double",
            "default": 0.0
          },
          "column_names_side": {
            "$ref": "#/$defs/Side",
            "default": "top"
          },
          "group_bar_height": {
            "type": "number",
            "format": "double",
            "default": 1.0
          },
          "cluster_bar_width": {
            "type": "number",
            "format": "double",
            "default": 5.0
          },
          "cluster_bar_side": {
            "$ref": "#/$defs/Side",
            "default": "left"
          },
          "row_title_rot": {
            "type": "number",
            "format": "double",
            "default": 0.0
          },
          "show_row_names": {
            "description": "`null` lets the engine decide based on row count.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "show_row_title": {
            "type": "boolean",
            "default": true
          },
          "row_names_italic": {
            "type": "boolean",
            "default": true
          },
          "show_column_names": {
            "type": "boolean",
            "default": true
          },
          "show_annotation_name": {
            "type": "boolean",
            "default": false
          },
          "group_legend_title": {
            "type": [
              "string",
              "null"
            ],
            "default": ""
          },
          "show_title": {
            "type": "boolean",
            "default": false
          },
          "show_batch": {
            "type": "boolean",
            "default": true
          },
          "font_size": {
            "type": "number",
            "format": "double",
            "default": 9.0
          },
          "marker_font_size": {
            "type": "number",
            "format": "double",
            "default": 8.0
          },
          "max_cluster_rows": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 5000
          },
          "use_raster": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "raster_quality": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 1
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "png"
            ]
          },
          "dpi": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 600
          }
        }
      },
      "HeatmapTransform": {
        "type": "string",
        "enum": [
          "vst",
          "logcpm"
        ]
      },
      "HeatmapScale": {
        "type": "string",
        "enum": [
          "row",
          "none"
        ]
      },
      "Side": {
        "type": "string",
        "enum": [
          "top",
          "bottom",
          "left",
          "right"
        ]
      },
      "OverallHeatmap": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "name": {
            "type": "string",
            "default": "overall"
          },
          "gene_source": {
            "$ref": "#/$defs/GeneSource",
            "default": "variable"
          },
          "top_n": {
            "$ref": "#/$defs/TopN",
            "default": "all"
          },
          "expressed_only": {
            "type": "boolean",
            "default": true
          },
          "comparisons": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "max_genes": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 2000
          },
          "marker_genes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "RPE65",
              "MITF",
              "BEST1",
              "NANOG",
              "SOX2",
              "POU5F1",
              "PAX6",
              "PMEL",
              "RAX",
              "TYR",
              "OTX2",
              "TYRP1",
              "MERTK",
              "LHX2",
              "VSX2",
              "DCT",
              "RLBP1"
            ]
          },
          "marker_add_missing": {
            "type": "boolean",
            "default": true
          },
          "n_clusters": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0,
            "default": 3
          },
          "sample_correlation": {
            "type": "boolean",
            "default": true
          },
          "correlation_palette": {
            "type": "string",
            "default": "YlOrRd"
          },
          "correlation_show_annotation_name": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "GeneSource": {
        "type": "string",
        "enum": [
          "variable",
          "deg"
        ]
      },
      "TopN": {
        "description": "`top_n` accepts a number or the literal \"all\".",
        "anyOf": [
          {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          {
            "type": "string"
          }
        ]
      },
      "SelectedHeatmapJob": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "default": ""
          },
          "title": {
            "type": "string",
            "default": ""
          },
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "samples": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "gene_groups": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "n_clusters": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          },
          "options": {
            "$ref": "#/$defs/SelectedHeatmapOptions",
            "default": {}
          }
        }
      },
      "SelectedHeatmapOptions": {
        "type": "object",
        "properties": {
          "cluster_rows": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "cluster_columns": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "show_row_dend": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "show_column_dend": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "border": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "show_row_title": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "width": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "PlotsConfig": {
        "type": "object",
        "properties": {
          "formats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "png"
            ]
          },
          "dpi": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 300
          },
          "font_family": {
            "type": "string",
            "default": "Arial"
          },
          "base_size": {
            "type": "number",
            "format": "double",
            "default": 7.0
          },
          "group_palette": {
            "type": "string",
            "default": "npg"
          },
          "plot_pad_mm": {
            "type": "number",
            "format": "double",
            "default": 2.0
          },
          "label_halo": {
            "type": "boolean",
            "default": true
          },
          "legend_gap_mm": {
            "type": "number",
            "format": "double",
            "default": 0.8
          },
          "pca": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PcaJob"
            },
            "default": [
              {
                "name": "PCA_selected",
                "ntop": 500,
                "pcs": [
                  1,
                  2
                ],
                "label_samples": true,
                "ellipse": false,
                "legend_pos": "right",
                "square_panel": true,
                "width_mm": 76.0,
                "height_mm": 62.0
              }
            ]
          },
          "volcano": {
            "$ref": "#/$defs/VolcanoOptions",
            "default": {
              "enabled": true,
              "label_top": 10,
              "point_size": 0.5,
              "width_mm": 78.0,
              "height_mm": 70.0,
              "legend_pos": "right",
              "show_subtitle": false
            }
          },
          "additional": {
            "$ref": "#/$defs/AdditionalPlotsOptions",
            "default": {
              "enabled": true,
              "ma": true,
              "sample_distance": true,
              "mds": true,
              "library_size": true,
              "expression_distribution": true,
              "deg_summary": true,
              "deg_dotplot": true,
              "gene_expression": true,
              "upset": true,
              "deg_matrix": true,
              "inferential_annotations": false,
              "top_n": 15,
              "label_top": 10,
              "genes": [
                "RPE65",
                "MITF",
                "BEST1",
                "NANOG",
                "SOX2",
                "POU5F1",
                "PAX6",
                "PMEL",
                "RAX",
                "TYR",
                "OTX2",
                "TYRP1",
                "MERTK",
                "LHX2",
                "VSX2",
                "DCT",
                "RLBP1"
              ],
              "width_mm": 89.0,
              "height_mm": 70.0
            }
          }
        }
      },
      "PcaJob": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "default": "PCA_selected"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "samples": {
