src-tauri/target/
src-tauri/gen/
mynx-next/src-tauri/gen/
installer/src-tauri/gen/

# Cargo (local build target redirect)
.cargo/

# Internal docs (not for GitHub) — root docs/ only; mynx-next/docs is
