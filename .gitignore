pnpm-debug.log*
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

# Tauri installer output (single exe deliverable - not tracked)
release-installer/

# Release files are uploaded to GitHub Releases, not committed to the source tree.
/mynx-installer.exe
/mynx-installer.exe.build.json
*.exe.sig
*.dmg
*.app.tar.gz
*.app.tar.gz.sig
latest.json

# Installer payload exe — regenerated by scripts/sync-installer-payload.cjs
# (built during CI before the installer compile; never commit the binary)
installer/src-tauri/resources/mynx.exe
installer/src-tauri/resources/mynx.exe.gz
installer/src-tauri/resources/mynx.exe.gz.*.tmp
installer/src-tauri/resources/mynx-payload.json

