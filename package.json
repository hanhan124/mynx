{
  "name": "mynx",
  "private": true,
  "version": "3.0.2",
  "license": "Apache-2.0",
  "type": "module",
  "repository": "https://github.com/hanhan124/mynx",
  "scripts": {
    "dev": "vite --port 1421 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig tsconfig.json",
    "check:watch": "svelte-check --tsconfig tsconfig.json --watch",
    "test": "vitest run src",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "tauri": "tauri",
    "typecheck": "svelte-check --tsconfig tsconfig.json",
    "test:rust": "cargo test --workspace --locked --manifest-path src-tauri/Cargo.toml",
    "test:r:engine": "node --experimental-strip-types scripts/rnaseq-engine-smoke.ts",
    "test:r:numeric": "Rscript tests/r/rna-numeric-benchmark.R",
    "bench:matrix": "node --experimental-strip-types scripts/matrix-benchmark.ts",
    "charts:inventory": "node scripts/validate-chart-inventory.mjs",
    "charts:links": "node scripts/check-chart-links.mjs",
    "charts:references": "node scripts/fetch-chart-references.mjs",
    "charts:optimize-references": "node scripts/optimize-chart-reference-pngs.mjs",
    "charts:visual": "python scripts/chart-visual-regression.py",
    "charts:mappings": "node scripts/check-chart-mappings.mjs",
    "charts:schema": "vitest run src/features/charts/catalog.spec.ts",
    "charts:check": "npm run charts:schema && node scripts/check-charts.mjs",
    "charts:smoke": "Rscript scripts/chart-template-smoke.R",
    "charts:verify": "npm run charts:check && npm run charts:smoke && npm run charts:visual",
    "version": "node scripts/sync-version.cjs",
    "version:check": "node scripts/sync-version.cjs --check",
    "branding:check": "node scripts/check-branding.cjs",
    "resources:check": "node scripts/check-r-resources.cjs",
    "prebuild": "node scripts/sync-version.cjs",
    "installer:payload": "node scripts/sync-installer-payload.cjs",
    "installer:uninstaller": "npm ci --prefix installer && npm run tauri:uninstaller --prefix installer && node scripts/sync-installer-uninstaller.cjs",
    "installer:dev": "npm run tauri:dev --prefix installer",
    "installer:build": "npm run tauri -- build --no-bundle && npm run installer:uninstaller && npm run installer:payload && npm run tauri:build --prefix installer && node scripts/post-installer-build.cjs",
    "installer:clean": "node scripts/clean-installer-artifacts.cjs",
    "check:release": "npm run version:check && npm run branding:check && npm run resources:check && npm run typecheck && npm run lint && npm test && npm run test:rust && npm run tauri -- build --no-bundle && npm run installer:uninstaller && npm run installer:payload",
    "mac:build": "npm run tauri -- build --target aarch64-apple-darwin",
    "mac:build:intel": "npm run tauri -- build --target x86_64-apple-darwin",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tabler/icons-svelte": "^3.52.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/svelte-table": "^9.3.2",
    "@tanstack/svelte-virtual": "^3.13.52",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-updater": "2.10.1",
    "bits-ui": "^1.8.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.3",
    "@tsconfig/svelte": "^5.0.9",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
